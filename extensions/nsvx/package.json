{
  "name": "@openclaw/nsvx",
  "version": "2026.10.10",
  "private": true,
  "description": "OpenClaw workspace for NSVX actions, the agent team, and parity progress",
  "type": "module",
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.18",
    "solid-js": "2.0.0-rc.18",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "@solidjs/compiler": "2.0.0-rc.18",
    "esbuild": "0.28.2",
    "openclaw": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "controlUi": "./src/control-ui.tsx",
    "assetScripts": {
      "build": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/nsvx",
      "copy": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/nsvx --copy",
      "buildOutputs": [
        "dist/openclaw.plugin.json"
      ]
    }
  }
}
